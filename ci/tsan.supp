# Thread Sanitizer suppressions (D-142). Only third-party libraries that
# are not built with TSan and run their own threads; our own code is never
# suppressed here.
# FFmpeg decodes with internal frame/slice threads (through OpenCV videoio).
called_from_lib:libavcodec.so
called_from_lib:libavutil.so
called_from_lib:libavformat.so
called_from_lib:libswscale.so
race:libavutil.so
race:libavcodec.so
# OpenCV's own thread pool (parallel_for_) in imgproc/video kernels.
called_from_lib:libopencv_core.so
# OpenCV frees its thread-local storage (allocated in libopencv_core) with a
# mutex at thread exit; TSan cannot see OpenCV's locking.
mutex:__GI___nptl_deallocate_tsd
mutex:__nptl_deallocate_tsd
